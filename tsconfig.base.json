{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ES2022",
        "noUnusedLocals": false,
        "strict": true,
        "esModuleInterop": true,
        "lib": ["DOM", "es2021"],
        "skipLibCheck": true,
        "incremental": false
    }
}
