{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "declaration": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2024",
        "outDir": "dist",
        "noUnusedLocals": false,
        "strict": true,
        "esModuleInterop": true,
        "lib": ["ES2024"],
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["./index.ts", "./bin/**/*", "./lib/**/*", "./test/**/*"]
}
