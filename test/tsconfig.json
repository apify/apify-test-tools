{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2024",
        "outDir": "dist",
        "rootDir": "..",
        "noUnusedLocals": false,
        "noEmit": true,
        "lib": ["ES2024"],
        "skipLibCheck": true
    },
    "include": ["./**/*"]
}
