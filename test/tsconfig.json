{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ES2022",
        "outDir": "dist",
        "noUnusedLocals": false,
        "noEmit": true,
        "rootDir": "..",
        "lib": ["DOM", "es2021"],
        "skipLibCheck": true
    },
    "include": ["./**/*", "../bin/**/*", "../lib/**/*"]
}
