{
    "mode": "grouped",

    "actors": [
        {
            "actorFullName": "apify/e-commerce-scraping-tool",
            "folder": "actors/e-commerce-scraper/actors/apify_e-commerce-scraper"
        },
        {
            "actorFullName": "e-commerce/e-commerce-food-delivery",
            "folder": "actors/e-commerce-scraper/actors/apify_e-commerce-food-delivery"
        },
        {
            "actorFullName": "e-commerce/e-commerce-influencer",
            "folder": "actors/e-commerce-scraper/actors/apify_e-commerce-influencer"
        },
        {
            "actorFullName": "e-commerce/e-commerce-products",
            "folder": "actors/e-commerce-scraper/actors/apify_e-commerce-product"
        },
        {
            "actorFullName": "e-commerce/e-commerce-reviews",
            "folder": "actors/e-commerce-scraper/actors/apify_e-commerce-reviews"
        },
        {
            "actorFullName": "e-commerce/e-commerce-search-engine",
            "folder": "actors/e-commerce-scraper/actors/apify_e-commerce-search-engine"
        },
        {
            "actorFullName": "e-commerce/e-commerce-seller",
            "folder": "actors/e-commerce-scraper/actors/apify_e-commerce-seller"
        },
        { "actorFullName": "e-commerce/ebay-standby", "folder": "actors/ebay" },
        { "actorFullName": "e-commerce/shopify-standby", "folder": "actors/shopify" },
        { "actorFullName": "e-commerce/e-commerce-standby-gap-inc", "folder": "actors-experimental/gap-inc" },
        { "actorFullName": "e-commerce/e-commerce-standby-abercrombie", "folder": "actors-experimental/abercrombie" },
        { "actorFullName": "e-commerce/e-commerce-standby-chicos", "folder": "actors-experimental/chicos" }
    ],

    "configs": [
        {
            "actorNameGlob": "*/*",
            "tokenEnvVar": "APIFY_TOKEN_E_COMMERCE",
            "reportSlackChannel": "#notif-e-commerce-scraping-tool"
        },
        {
            "actors": ["apify/e-commerce-scraping-tool"],
            "tokenEnvVar": "APIFY_TOKEN_APIFY",
            "releaseSlackChannel": "#delivery-public-actors"
        },
        {
            "folderGlob": "actors/e-commerce-scraper/**",
            "overrideActorContext": ["actors/e-commerce-scraper", "packages/external/protocol"]
        },
        {
            "actors": ["e-commerce/ebay-standby", "e-commerce/shopify-standby"],
            "overrideActorContext": ["packages/external/protocol", "packages/internal/architecture", "test/platform"]
        },
        {
            "folderGlob": "actors-experimental/*",
            "overrideActorContext": ["packages/external/protocol", "packages/internal/architecture"],
            "envVars": {
                "GHOST_FETCH_URL": { "fromEnv": "GHOST_FETCH_URL", "isSecret": false, "isShared": true }
            }
        }
    ]
}
