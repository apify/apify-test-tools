{
    "mode": "grouped",

    "website-content-crawler": {
        "tokenEnvVar": "APIFY_ACTOR_BUILD_TOKEN",
        "reportSlackChannel": "#notif-store-website-content-crawler",
        "envVars": {
            "RENDERING_TYPE_DETECTION_RESULT_DB_URI": {
                "fromEnv": "RENDERING_TYPE_DETECTION_RESULT_DB_URI",
                "isSecret": true,
                "isShared": true
            }
        },
        "actors": [
            {
                "folder": ".",
                "actorFullName": "apify/website-content-crawler",
                "envVars": {
                    "RENDERING_TYPE_DETECTION_RESULT_DB_URI": {
                        "fromEnv": "RENDERING_TYPE_DETECTION_RESULT_DB_URI",
                        "isSecret": true,
                        "isShared": true
                    },
                    "WEB_BOT_AUTH_PRIVATE_KEY": {
                        "fromEnv": "WEB_BOT_AUTH_PRIVATE_KEY",
                        "isSecret": true,
                        "isShared": true
                    },
                    "UNBLOCKER_PROXY_TOKEN": { "fromEnv": "UNBLOCKER_PROXY_TOKEN", "isSecret": true, "isShared": true },
                    "UNBLOCKER_STATS_TOKEN": { "fromEnv": "UNBLOCKER_STATS_TOKEN", "isSecret": true, "isShared": false }
                }
            },
            {
                "folder": "data-visualizations",
                "actorFullName": "apify/website-content-crawler-data-viz"
            }
        ]
    }
}
