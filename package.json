{
    "name": "apify-test-tools",
    "version": "0.10.2",
    "type": "module",
    "description": "TBD",
    "repository": {
        "type": "git",
        "url": "https://github.com/apify/apify-test-tools.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=11.10.0",
            "onFail": "warn"
        }
    },
    "bin": {
        "apify-test-tools": "dist/bin/main.js"
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/lib/lib.js",
    "dependencies": {
        "@apify/consts": "^3.0.1",
        "@slack/web-api": "^8.2.0",
        "adm-zip": "^0.6.1",
        "apify-client": "^2.25.0",
        "ignore": "^7.0.5",
        "picomatch": "^4.0.7",
        "yargs": "^18.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@apify/eslint-config": "^1.0.0",
        "@apify/tsconfig": "^0.1.1",
        "@types/adm-zip": "^0.5.8",
        "@types/node": "^24.0.0",
        "@types/picomatch": "^4.0.3",
        "@types/yargs": "^17.0.33",
        "esbuild": "0.25.12",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "husky": "^9.0.11",
        "knip": "^5.65.0",
        "lint-staged": "^15.2.2",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "vitest": ">=3.2.4"
    },
    "scripts": {
        "start": "npm run dist/bin/main.js",
        "start:dev": "cd local-clone && tsx ../bin/main.ts",
        "build": "tsc && chmod +x ./dist/bin/main.js",
        "bundle": "esbuild bin/main.ts --bundle --minify --platform=node --format=esm --target=node22 --log-level=warning --banner:js=\"import{createRequire as __createRequire}from'node:module';const require=__createRequire(import.meta.url);\" --outfile=.github/cli/apify-test-tools.mjs",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "test": "vitest run --exclude 'test/e2e/**'",
        "test:e2e": "vitest run test/e2e",
        "check-unused": "npx knip",
        "prepare": "husky .husky || true"
    },
    "lint-staged": {
        "*.js": "eslint",
        "*.ts": "eslint"
    },
    "author": "oklinov",
    "license": "ISC"
}
