{
    "name": "apify-test-tools-monorepo",
    "private": true,
    "type": "module",
    "description": "Monorepo for the apify-test-tools library and the @apify/test-tools-cli CLI",
    "repository": {
        "type": "git",
        "url": "https://github.com/apify/apify-test-tools.git"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "workspaces": [
        "packages/lib",
        "packages/cli"
    ],
    "devDependencies": {
        "@apify/eslint-config": "^1.0.0",
        "@apify/tsconfig": "^0.1.1",
        "@types/adm-zip": "^0.5.8",
        "@types/node": "^24.0.0",
        "@types/picomatch": "^4.0.3",
        "@types/yargs": "^17.0.33",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "husky": "^9.0.11",
        "knip": "^5.65.0",
        "lint-staged": "^15.2.2",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1",
        "vitest": "^3.2.4"
    },
    "scripts": {
        "start:dev": "cd local-clone && tsx ../packages/cli/src/main.ts",
        "build": "npm run build --workspaces",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "check-unused": "npx knip",
        "prepare": "husky .husky || true"
    },
    "lint-staged": {
        "*.js": "eslint",
        "*.ts": "eslint"
    },
    "author": "oklinov",
    "license": "ISC"
}
